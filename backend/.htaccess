# Deny direct access to internal folders. This comes first: the catch-all rewrite below ends the rule processing.
RewriteEngine On
RewriteRule ^(vendor|src|config|logs|bin|cache|setup)(/|$) - [F,L]
RewriteRule ^\.env - [F,L]

# Redirect all requests to the public/ folder
RewriteRule ^$ public/ [L]
RewriteRule (.*) public/$1 [L]

# Security: prevent directory listing
Options -Indexes

# Security: deny access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
