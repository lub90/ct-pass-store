# PHPStan configuration (see specs/backend-plan.md, item 0.3).
# Existing findings are recorded in phpstan-baseline.neon; new code must not add any.
# Raise the level step by step; shrink the baseline as code gets cleaned up.
includes:
    - phpstan-baseline.neon
    - phpstan-security.neon

parameters:
    level: 6
    paths:
        - src
        - public
        - tests
    tmpDir: .phpstan.cache
    excludePaths:
        # Deliberately contains banned calls; analysed only by tests/Unit/Security/BannedCallsTest.php
        - tests/Fixtures/BannedCalls
