<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local configuration for the end-to-end tests. Copy it to phpunit.xml (gitignored) and fill in your
    test instance. Run with `composer test:contract` or `composer test:load`, only against a TEST instance. See docs/testing.md.
-->
<phpunit bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Api">
            <directory>tests/Api</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <testsuite name="Load">
            <directory>tests/Load</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- Environment variables for your ChurchTools API -->
        <env name="CT_API_URL" value="https://your.church.tools/api"/>
        <env name="CT_API_TOKEN" value="YOUR_API_TOKEN_WITH_READ_AND_WRITE_ACCESS_TO_YOUR_CHURCHTOOLS_BACKEND_CATEGORIES"/>
    </php>
</phpunit>