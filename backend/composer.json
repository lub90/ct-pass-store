{
  "name": "lub90/ct-pass-store",
  "description": "Secure secondary password store for ChurchTools authentication and IP filtering.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.5",
    "monolog/monolog": "^2.9",
    "php-di/php-di": "^7.1",
    "guzzlehttp/guzzle": "^7.10",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "CtPassStore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CtPassStore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist --testsuite Unit,Api",
    "test:e2e": "phpunit -c phpunit.xml --testsuite EndToEnd",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts-descriptions": {
    "test": "Run the unit and API tests (no network access needed)",
    "test:e2e": "Run the end-to-end tests against a ChurchTools instance (needs a local phpunit.xml, see docs/testing.md)",
    "stan": "Run PHPStan",
    "cs": "Check the code style",
    "cs:fix": "Fix the code style",
    "check": "Run code style, PHPStan and unit tests, like the CI"
  }
}
