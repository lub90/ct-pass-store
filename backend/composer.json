{
  "name": "lub90/ct-pass-store",
  "description": "Secure secondary password store for ChurchTools authentication and IP filtering.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.5",
    "monolog/monolog": "^2.9",
    "php-di/php-di": "^7.1",
    "guzzlehttp/guzzle": "^7.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.3"
  },
  "autoload": {
    "psr-4": {
      "CtPassStore\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CtPassStore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
