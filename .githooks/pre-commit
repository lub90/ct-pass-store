#!/bin/sh
# Pre-commit privacy and secrets check (README.md, "Pre-commit check"). Enable per clone:
#   sh scripts/install-hooks.sh        (or: git config core.hooksPath .githooks)
# Emergency bypass, rare and deliberate: git commit --no-verify
#
# 1. scripts/check-private.mjs: block list .private-terms and local credential-file values (never printed).
# 2. gitleaks on the staged changes, if a gitleaks binary is on PATH (nothing is downloaded).

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
root=$(git rev-parse --show-toplevel) || exit 1
fail() {
  echo "pre-commit: commit refused. Values are not shown: look up the entry in its source file and remove or rephrase the line (emergency bypass: git commit --no-verify)." >&2
  exit 1
}

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; the privacy check can't run (install Node, or bypass with git commit --no-verify)." >&2
  exit 1
fi
node "$hook_dir/../scripts/check-private.mjs" --staged
status=$?
[ "$status" -eq 0 ] || fail

if command -v gitleaks >/dev/null 2>&1; then
  set -- --redact --no-banner --exit-code 1
  [ -f "$root/.gitleaks.toml" ] && set -- "$@" --config "$root/.gitleaks.toml"
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged "$@" "$root" || fail     # gitleaks >= 8.19
  else
    gitleaks protect --staged "$@" --source "$root" || fail     # older gitleaks 8.x
  fi
else
  echo "pre-commit: hint: gitleaks not on PATH; secret-pattern scan skipped (CI still runs it)." >&2
fi
exit 0
