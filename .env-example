# Database connection
DB_DSN=mysql:host=localhost;dbname=ctpassstore;charset=utf8mb4
DB_USER=root
DB_PASS=secret

# ChurchTools API
CT_API_URL=https://churchtools.example/api

# IP filtering (optional, comma-separated)
ALLOWED_IPS=192.168.0.0/24,vpn.example.org/32

# Logging level (optional)
LOG_LEVEL=DEBUG
