{
    "name": "ctpassstore",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/check-dist.js",
        "preview": "vite preview",
        "test": "vitest run",
        "test:contract": "vitest run --config vitest.contract.config.ts",
        "test:browser": "echo \"test:browser: Playwright is set up in a later task\"",
        "lint": "eslint .",
        "typecheck": "vue-tsc --noEmit",
        "check": "npm run lint && npm run typecheck && npm test && npm run build",
        "deploy": "npm run build && node scripts/package.js"
    },
    "dependencies": {
        "@churchtools/churchtools-client": "^1.7.3",
        "@mdi/js": "^7.4.47",
        "vue": "^3.5.45",
        "vue-i18n": "^11.4.19",
        "vue-router": "^5.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/compiler-dom": "^3.5.45",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "jsdom": "^29.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
